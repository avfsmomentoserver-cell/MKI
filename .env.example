# MKC environment template — copy to .env and fill in real values.
# .env is gitignored; this file is the committed example.

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME

# SQLAlchemy URL used by the backend (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@localhost:5432/CHANGE_ME

# Random 40+ char shared secret for the MKC REST API (e.g. `openssl rand -hex 20`)
MKC_API_TOKEN=CHANGE_ME
